@using EduTrack.Web.Models.Course
@model CourseDetailViewModel

@{
    ViewData["Title"] = "Materials";
}
<main class="py-4">
    <partial name="Partials/_CourseHeaderPartial" model="Model.CourseDetail" />

    <h1 class="page-title h2">Materials</h1>
    <p class="text-secondary">Course resources for Computer Science 101.</p>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <span class="badge text-bg-primary mb-2">Slides</span>
                    <h2 class="h5">Week 5: Web fundamentals</h2>
                    <p class="text-secondary">HTML structure, Bootstrap layout, and accessibility basics.</p>
                    <a class="btn btn-outline-success btn-sm" href="#">Open resource</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <span class="badge text-bg-info mb-2">Document</span>
                    <h2 class="h5">C# naming guide</h2>
                    <p class="text-secondary">Simple conventions for variables, methods, classes, and folders.</p>
                    <a class="btn btn-outline-success btn-sm" href="#">Open resource</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <span class="badge text-bg-secondary mb-2">Link</span>
                    <h2 class="h5">Practice repository</h2>
                    <p class="text-secondary">Starter exercises for loops, lists, and validation.</p>
                    <a class="btn btn-outline-success btn-sm" href="#">Open resource</a>
                </div>
            </div>
        </div>
    </div>
</main>