@using EduTrack.Application.DTOs.StreamPost
@using EduTrack.Domain.Constants
@{
    ViewData["Title"] = "Course Detail";
}

@model List<StreamPostDto>


<main class="py-4">
    <partial name="Partials/_CourseHeaderPartial" />

    <div class="">

        @if (User.IsInRole(RoleConstants.Admin) || User.IsInRole(RoleConstants.Instructor))
        {
            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="post">Share with your class</label>
                    <textarea id="post" class="form-control mb-3" rows="3" placeholder="Announce something to the class"></textarea>
                    <button class="btn btn-success">Post</button>
                </div>
            </div>
        }


        <div class="vstack gap-3">

            @foreach (var post in Model)
            {
                <div class="card stream-item">
                    <div class="card-body">
                        <div class="d-flex gap-3">
                            <span class="avatar">@post.InstructorInitials</span>
                            <div>
                                <h2 class="h6 mb-1">@post.Title</h2>
                                <p class="mb-1">@post.Content</p>
                                <small class="text-secondary">@post.Date.ToString("f")</small>
                            </div>
                        </div>
                    </div>
                </div>
            }


        </div>
    </div>


</main>